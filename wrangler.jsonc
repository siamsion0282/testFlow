{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testflow-photo-studio",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-14",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "observability": { "enabled": true }
}
